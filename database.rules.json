{
  "rules": {
    "status": {
      ".read": "auth != null",
      ".indexOn": ["online"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'online', 'lastSeen'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
        "online": { ".validate": "newData.isBoolean()" },
        "playing": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
